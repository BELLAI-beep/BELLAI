# BELLAI 환경변수 설정
# Vercel 대시보드 > Settings > Environment Variables 에 입력

# Claude (Anthropic) - https://console.anthropic.com
CLAUDE_API_KEY=sk-ant-api03-여기에입력

# GPT (OpenAI) - https://platform.openai.com
GPT_API_KEY=sk-proj-여기에입력

# Gemini (Google) - https://aistudio.google.com (무료)
GEMINI_API_KEY=AIza여기에입력

# DeepSeek - https://platform.deepseek.com (초저가)
DEEPSEEK_API_KEY=sk-여기에입력

# Groq - https://console.groq.com (무료)
GROQ_API_KEY=gsk_여기에입력

# Grok (xAI) - https://console.x.ai (실시간 웹)
GROK_API_KEY=xai-여기에입력
